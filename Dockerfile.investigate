# syntax=docker/dockerfile:1
FROM rust:1.99.1-slim-bookworm AS rust-builder
WORKDIR /build
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
RUN cargo build --locked --release -p graphlayer-engine

FROM golang:1.25-bookworm AS app-builder
WORKDIR /build
COPY platform/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /graphlayer-investigate ./cmd/graphlayer-investigate

FROM debian:bookworm-slim
RUN groupadd --gid 10001 graphlayer && useradd --uid 10001 --gid 10001 --create-home graphlayer
WORKDIR /app
COPY --chmod=0555 --from=rust-builder /build/target/release/graphlayer-engine ./graphlayer-engine
COPY --chmod=0555 --from=app-builder /graphlayer-investigate ./graphlayer-investigate
USER 10001:10001
# The investigation service deliberately binds loopback only. Use host network
# mode on Linux; publishing a bridge-network port does not expose this service.
ENTRYPOINT ["/app/graphlayer-investigate"]
